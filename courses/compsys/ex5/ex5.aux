\@writefile{toc}{\contentsline {subsection}{\numberline {1.1}Numerical calculations of the Ginibre disk}{1}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {1.2}The scaling of the disk radius with N}{1}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Eigeanvalues distributions. The figure on the left shows the distribution of the real and imaginary parts. The values clearly follow the semicircular law. On the right, a scatter plot of the eigenvalues in the complex plane. The Ginibre disk is clearly visible with radius $10$.}}{2}{}\protected@file@percent }
\newlabel{fig:part1a}{{1}{2}{}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The magnitude and phase of the complex eigenvalues. The graph on the left shows the radial distribution of the eigenvalues while the graph on the right shows the phase distribution. It's clear that the phase is uniformly distributed while the radial part is linearly distributed, fitting the Jacobean. At the edge of the radial distribution the edge of the semi-circle law is visible.}}{2}{}\protected@file@percent }
\newlabel{fig:part1b}{{2}{2}{}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Graphs comparing the maximal magnitude of the eigenvalues as a function of matrix size. The graph on the left shows the regular scale while the graph on the right shows the logarithmic scale.}}{3}{}\protected@file@percent }
\newlabel{fig:part1c}{{3}{3}{}{figure.3}{}}
